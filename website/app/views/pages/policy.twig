{% extends 'layouts/main.twig' %}

{% block title %}{{ policy.title }} | BizBandhan Pravah{% endblock %}

{% block content %}
    <article class="section">
        <div class="section-title" style="text-align: left;">
            <h1>{{ policy.title }}</h1>
            <p style="opacity: 0.7;">Last Updated: {{ policy.updatedAt|date('F j, Y') }}</p>
        </div>
        
        <div class="card" style="background: var(--bg-card); padding: 50px; line-height: 1.8;">
            {{ policy.content|raw }}
        </div>
    </article>
{% endblock %}
